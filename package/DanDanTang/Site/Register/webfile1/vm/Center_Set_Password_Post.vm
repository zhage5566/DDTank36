<script type="text/javascript" language="javascript">
var xmlHttp = null;
　　　　var listLable=null;
　　　　function CheckUser(Control,lable,type)
　　　　{
　　　　　　try
　　　　　　{
　　　　　　　　xmlHttp = new ActiveXObject("Msxml2.XMLHTTP");
　　　　　　　　listLable=lable;
　　　　　　}
　　　　　　catch(err1)
　　　　　　{
　　　　　　　　try
