　　　　　　　　　　xmlHttp = new ActiveXObject("Microsoft.XMLHTTP");
　　　　　　　　}
　　　　　　　　catch(err2)
　　　　　　　　{
　　　　　　　　　　xmlHttp = new XMLHttpRequest();
　　　　　　　　}
　　　　　　}
　　　　　　var data = document.getElementById(Control);
　　　　　　var url = "check.aspx?ControlData=" + data.value+"&&type="+type;
　　　　　　xmlHttp.open("GET",url,true);
　　　　　　xmlHttp.onreadystatechange = OnHandler;
　　　　　　xmlHttp.send(null);
　　   }
　　　 function OnHandler()
　　　　{
　　　　　　if(xmlHttp.readyState == 4)
　　　　　　{
　　　　　　　　var isValid = xmlHttp.responseText;
　　　　　　　　var exists = document.getElementById(listLable);
　　　　　　　　exists.innerHTML = isValid;
　　　　　　}
　　　　}
　　 function checkconfirmpwd(tp1,tp2,list3)
     {
