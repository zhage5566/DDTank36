<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
	<title>重置密码</title>
	<link href="$WebfileServer/style/style.css" rel="stylesheet" type="text/css" />
	<meta http-equiv="Content-Type" content="text/html; charset=gb2312" />
    <script type="text/javascript" src="$WebfileServer/js/passwordstrength_asc1.js"></script>
<script type="text/javascript" language="javascript">
　　　　var xmlHttp = null;
　　　　var listLable=null;
　　　　function CheckUser(Control,lable,type)
　　　　{
　　　　　　try
　　　　　　{
　　　　　　　　xmlHttp = new ActiveXObject("Msxml2.XMLHTTP");
　　　　　　　　listLable=lable;
　　　　　　}
　　　　　　catch(err1)
　　　　　　{
　　　　　　　　try
　　　　　　　　{
　　　　　　　　　　xmlHttp = new ActiveXObject("Microsoft.XMLHTTP");
　　　　　　　　}
　　　　　　　　catch(err2)
　　　　　　　　{
　　　　　　　　　　xmlHttp = new XMLHttpRequest();
　　　　　　　　}
　　　　　　}
　　　　　　var data = document.getElementById(Control);
　　　　　　var url = "check.aspx?ControlData=" + data.value+"&&type="+type;
　　　　　　xmlHttp.open("GET",url,true);
　　　　　　xmlHttp.onreadystatechange = OnHandler;
　　　　　　xmlHttp.send(null);
　　   }
　　　 function OnHandler()
　　　　{
　　　　　　if(xmlHttp.readyState == 4)
　　　　　　{
　　　　　　　　var isValid = xmlHttp.responseText;
　　　　　　　　var exists = document.getElementById(listLable);
　　　　　　　　exists.innerHTML = isValid;
　　　　　　}
　　　　}
　　 function checkconfirmpwd(tp1,tp2,list3)
     {
          var two= document.getElementById(list3);
           if(document.getElementById(tp1).value!=document.getElementById(tp2).value)
            {                                             
 　　　　　　　　two.innerHTML = "两次输入不成功";
            } 
            else
            {
                two.innerHTML = "成功";
            }
      }     
</script>
<title>修改密码</title>
</head>
<html>
<body>
<form action="resetpw_byDNAEmail_post.aspx" method="post" name="form1">
  <div class="main">
    <div class="top_bg_a"></div>
    <div class="reg_bg">
      <div class="nav">
        <ul>
						<li class="logo"><a href="http://127.0.0.1/" title="弹弹堂"></a></li>
						<li class="space"></li>
						<li class="nav_BackHome"><a href="Userlogin.aspx" title="注册账号"></a></li>
						<li class="reg"><a href="Reg.aspx" title="注册账号"></a></li>
						<li class="change"><a href="Change_Password.aspx" title="修改密码"></a></li>				
						<li class="forget"><a href="Forget_password.aspx" title="忘记密码"></a></li>
						<li class="ingame"><a href="http://127.0.0.1/" title="弹弹堂"></a></li>		
        </ul>
      </div>
      <div class="reg_content ">
        <div class="reg_title"><span class="title_Highlight">修改密码：</span></div>
        <div class="reg_table">
          <table cellspacing="0" cellpadding="0" width="650" border="0">
            <tbody>
              <tr>
                <td align="right" width="107" height="32">用户名：</td>
                <td width="483"><strong>$User_Name</strong></td>
                <td width="60"><label id="LbName"></label></td>
              </tr>
              <tr>
                <td colspan="3" height="8"><div class="reg_s_line"></div></td>
              </tr>
              <tr>
                <td align="right" height="32">新密码：</td>
                <td><INPUT class="reg_input" onblur=CheckPassword() onkeydown=CheckPwdLength(event) id=TextPassword onfocus=DisplayHelp(2) tabIndex=3 onkeyup=ps.update(this.value); maxLength=10 size=40 type=password name=TextPassword />	</td>
                                    			
                <td><label id="Lb_Password"></label></td>
              </tr>
                            <tr>
                                <td height="32" align="right"><span class="reg_font_c">密码强度：</span></td>
                                <td>
                                    <!-- 密码强度 开始 -->
                                    <SCRIPT language=javascript>
                                        var ps = new PasswordStrength();
                                        ps.setMinLen(4);
                                    </SCRIPT>
                                    <!-- 密码强度 结束 -->
                                </td>
                                <td>&nbsp;</td>
                            </tr>			  
              <tr>
                <td colspan="3" height="8"><div class="reg_s_line"></div></td>
              </tr>
              <tr>
                <td align="right" height="32">重复新密码：</td>
                <td><input class="reg_input" id="TextPassword2" type="password"  onBlur="checkconfirmpwd('TextPassword2','TextPassword','Lb_Password2')"  maxlength="18"  name="TextPassword2" /></td>
                <td><label id="Lb_Password2"></label></td>
              </tr>
              <tr></tr>
              <tr>
                <td colspan="3" height="8"><div class="reg_s_line"></div></td>
              </tr>
              <tr>
                <td height="100">&nbsp;</td>
                <td colspan="2" valign="top"><input id="Ib_SetPassword" type="image" src="$WebfileServer/images/set_ok.jpg" width="104" height="40" name="Ib_SetPassword" /></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="bottom_bg_a"></div>
        <div class="copyright_web">&copy; 2022-2023 经典怀旧.com All Rights Reserved. 经典弹弹堂 版权所有</div>
  </div>
</form>
</body>
</html>
