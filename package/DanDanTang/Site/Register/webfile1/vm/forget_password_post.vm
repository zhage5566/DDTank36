<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  
  <head>
    <title>忘记密码</title>
    <link href="$WebfileServer/style/style.css" rel="stylesheet" type="text/css" />
    <meta http-equiv="Content-Type" content="text/html; charset=gb2312" /></head>
  <html>
    
    <body onload="MM_preloadImages('$WebfileServer/images/back_botton_over.jpg','$WebfileServer/images/close_window_over.jpg')">
      <form action="reg_ok.aspx" method="post" name="form1">
        <div class="main">
          <div class="top_bg_a"></div>
          <div class="reg_bg">
            <div class="nav">
              <ul>
                <li class="logo">
                  <a href="http://127.0.0.1/" title="弹弹堂"></a>
                </li>
                <li class="space"></li>
                <li class="nav_BackHome">
                  <a href="Userlogin.aspx" title="注册账号"></a>
                </li>
                <li class="reg">
                  <a href="Reg.aspx" title="注册账号"></a>
                </li>
                <li class="change">
                  <a href="Change_Password.aspx" title="修改密码"></a>
                </li>
                <li class="forget">
                  <a href="Forget_password.aspx" title="忘记密码"></a>
                </li>
                <li class="ingame">
                  <a href="http://127.0.0.1/" title="弹弹堂"></a>
                </li>
              </ul>
            </div>
            <div class="reg_content ">
              <div class="reg_title">
                <span class="title_Highlight">发送邮件：</span></div>
              <div class="reg_table">
                <table cellspacing="0" cellpadding="0" width="650" border="0">
                  <tbody>
                    <tr>
                      <td height="100" colspan="2" align="left">
                        <!-- 发送成功 -->
                        <div class="right_text" #if( $Result==true) style="display:block;" #else style="display:none;" #end>已经发送邮件至$Mail. 请点击邮件中的链接，设置你的新密码。</div>
                        <!-- 用户资料不正确 -->
                        <div class="err_text" #if( $Result==false) style="display:block;" #else style="display:none;" #end>发送邮件失败，用户名或邮箱地址不对，请稍后重试。</div></td>
                    </tr>
                    <tr>
                      <td width="391" colspan="2">&nbsp;</td></tr>
                    <tr>
                      <td height="120" colspan="2" align="center" valign="top">
                        <table width="224" border="0" cellspacing="0" cellpadding="0">
                          <tr>
                            <td align="center">
                              <a href="#" onclick="mm()" onmouseout="MM_swapImgRestore()" onmouseover="MM_swapImage('Image3','','$WebfileServer/images/close_window_over.jpg',1)">
                                <img src="$WebfileServer/images/close_window.jpg" name="Image3" width="84" height="36" border="0" id="Image3" /></a>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="bottom_bg_a"></div>
          <div class="copyright_web">&copy; 2007-2008 7road.com All Rights Reserved. 第七大道 版权所有</div></div>
        <script>function mm() {
            window.opener = null;
            window.close();
          }</script>
      </form>
    </body>
  </html>