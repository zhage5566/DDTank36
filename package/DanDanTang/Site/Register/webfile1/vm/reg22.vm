<script type="text/javascript" language="javascript">
　　　　var xmlHttp = null;
　　　　var listLable=null;
　　　　function CheckUser(Control,lable,type)
　　　　{
　　　　　　try
　　　　　　{
　　　　　　　　xmlHttp = new ActiveXObject("Msxml2.XMLHTTP");
　　　　　　　　　　　　　　}
　　　　　　catch(err1)
　　　　　　{
　　　　　　　　try
　　　　　　　　{
   　　　　　　　xmlHttp = new ActiveXObject("Microsoft.XMLHTTP");

　　　　　　　　}
　　　　　　　　catch(err2)
　　　　　　　　{
　　　　　　　　　　xmlHttp = new XMLHttpRequest();　        　 
　　　　　　　　}
　　　　　　}
          listLable=lable;
　　　　　　var data = document.getElementById(Control);
　　　　　　var url = "check.aspx?ControlData=" + data.value+"&&type="+type;
　　　　　　xmlHttp.open("GET",url,true);
　　　　　　xmlHttp.onreadystatechange = OnHandler;
　　　　　　xmlHttp.send(null);
　　   }
　　　 function OnHandler()
　　　　{
　　　　　　if(xmlHttp.readyState == 4)
　　　　　　{
　　　　　　　　var isValid = xmlHttp.responseText;
　　　　　　　　var exists = document.getElementById(listLable);
　　　　　　　　exists.innerHTML = isValid;
　　　　　　}
　　　　}
　　 function checkconfirmpwd(tp1,tp2,list3)
     {
          var two= document.getElementById(list3);
           if(document.getElementById(tp1).value==document.getElementById(tp2).value)            {                                             
              if(document.getElementById(tp1).value.length>=6)
                {
                  two.innerHTML = "<div class=\"ok\">成功</div>";
                }
               else
               {
                two.innerHTML = "<div class=\"err\">确认密码长度不够</div>";
               }

            } 
            else
            {
 　　　　　　　　two.innerHTML = "<div class=\"err\">您两次输入的登录密码不一致</div>";
            }
      }     
function killErrors() //杀掉所有的出错信息
  { 
	return true; 
  } 
  window.onerror = killErrors; 
</script>
