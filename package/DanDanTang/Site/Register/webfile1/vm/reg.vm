    <!-- Signup Section Begin -->
    <section class="signup spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="login__form">
                        <h3>账号注册</h3>
                        <form action="reg_ok.aspx" method="post" name="form1">
                            <div class="input__item">
                                <input type="text" name="TextName" id="TextName" placeholder="输入你要注册的游戏账号">
                                <span class="icon_profile"></span>
                            </div>
                            <div class="input__item">
                                <input type="password"  name="TextPassword"  id="TextPassword" placeholder="输入你的密码">
                                <span class="icon_lock"></span>
                            </div>
                            <div class="input__item">
                                <input type="password" name="TextPassword2" id="TextPassword2" placeholder="再次输入你的账号密码">
                                <span class="icon_lock"></span>
                            </div>
                            <div class="input__item" style="display:none">
								<label for="radio"><input name="usersex" type="radio"  value="true" checked="checked"/>男</label>
								<label for="radio2"><input type="radio" name="usersex"  value="false" />男</label>								
                            </div>
                            <div class="input__item">								
                                <input type="mail" name="TextEmail" id="TextEmail" placeholder="输入你的邮箱">
                                <span class="icon_mail"></span>
                            </div>							
                            <div class="input__item1">
							
                                <input type="text" name="Tb_VerifyCode" id="Tb_VerifyCode" placeholder="看不清?点击更换">
								<img id="imgVerify" width="84" height="36" src="VerifyCode.aspx?" alt="看不清？点击更换" onclick="this.src=this.src+'?'" />
                                <span class="icon_heart"></span>
                            </div>	
													
                            <button type="submit" name="Ib_Reg" class="site-btn">确认注册</button>
                        </form>
                        <h5>已经有账号了？恭喜你 <a href="\UserLogin.aspx">立刻开始游戏！</a></h5>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="login__social__links">
                        <h3>注册注意事项</h3>
                        <ul>
						<li><a href="#" class="facebook"><i ></i>请确保您设置的账号密码足够复杂.</a></li>
						  <li><a href="#" class="google"><i ></i>请记住不要随意把账号出借给他人.</a></li>
                         <li><a href="#" class="twitter"><i ></i>注册完账号后应尽快加群一起游玩.</a></li>
					    <li><a href="#" class="linkedin"><i ></i>任何问题请联系群主GM，谨防被骗.</a></li>
                        </ul>
                    </div>
                </div>
            </div>
