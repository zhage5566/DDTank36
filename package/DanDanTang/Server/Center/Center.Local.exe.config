<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="LanguagePath" value="Languages\Language-zh_cn.txt" />
    <add key="SystemNoticePath" value="Languages\SystemNotice.xml" />
    <add key="conString" value="Data Source=(localdb)\DDTank36;Initial Catalog=Db_Tank_S1;Integrated Security=True;MultipleActiveResultSets=True" />
    <add key="croCrossString" value="Data Source=(localdb)\DDTank36;Initial Catalog=Db_Membership;Integrated Security=True;MultipleActiveResultSets=True" />
    <add key="countDb" value="Data Source=(localdb)\DDTank36;Initial Catalog=Db_Count;Integrated Security=True;MultipleActiveResultSets=True" />
    <add key="IP" value="127.0.0.1" />
    <add key="Port" value="9402" />
    <add key="LoginLapseInterval" value="1" />
    <add key="SaveInterval" value="1" />
    <add key="SaveRecordInterval" value="1" />
    <add key="ScanAuctionInterval" value="60" />
    <add key="ScanMailInterval" value="120" />
    <add key="ScanConsortiaInterval" value="1" />
    <add key="ServerID" value="1" />
    <add key="GameType" value="1" />
    <add key="AreaID" value="1001" />
    <add key="LogPath" value="RecordLog" />
    <add key="TxtRecord" value="true" />
    <add key="HelpStr" value="退出:exit;重新加载:reload;系统公告:notice;ssssssss" />
    <add key="AAS" value="false" />
    <add key="DailyAwardState" value="true" />
  </appSettings>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="Center.Server.CenterServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <bindings>
      <netTcpBinding>
        <binding name="CenterService">
          <security mode="None"></security>
        </binding>
      </netTcpBinding>
    </bindings>
    <services>
      <service behaviorConfiguration="Center.Server.CenterServiceBehavior" name="Center.Server.CenterService">
        <host>
          <baseAddresses>
            <add baseAddress="http://127.0.0.1:2408/CenterService/" />
          </baseAddresses>
        </host>
        <endpoint address="net.tcp://127.0.0.1:9488/" binding="netTcpBinding" bindingConfiguration="CenterService" contract="Center.Server.ICenterService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>